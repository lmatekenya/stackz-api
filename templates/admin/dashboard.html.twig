{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}
    <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 20px;">

        <!-- Dashboard Heading -->
        <h1 class="text-center mb-5" style="font-size: 2.5rem;">📊 StackZ Admin Dashboard</h1>

        <!-- Stats Cards -->
        <div class="stats-grid" style="
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            margin-bottom: 50px;
        ">
            <div class="card stat-card" style="
                flex: 1 1 220px;
                max-width: 300px;
                background: #f8f9fa;
                border-radius: 12px;
                padding: 25px;
                text-align: center;
                box-shadow: 0 3px 8px rgba(0,0,0,0.1);
            ">
                <h3 style="font-size: 2rem; margin-bottom: 10px;">{{ totalUsers ?: '0' }}</h3>
                <p style="font-weight: 500; color: #555;">Registered Users</p>
            </div>

            <div class="card stat-card" style="
                flex: 1 1 220px;
                max-width: 300px;
                background: #f8f9fa;
                border-radius: 12px;
                padding: 25px;
                text-align: center;
                box-shadow: 0 3px 8px rgba(0,0,0,0.1);
            ">
                <h3 style="font-size: 2rem; margin-bottom: 10px;">{{ totalQuizzes ?: '0' }}</h3>
                <p style="font-weight: 500; color: #555;">Total Quizzes</p>
            </div>

            <div class="card stat-card" style="
                flex: 1 1 220px;
                max-width: 300px;
                background: #f8f9fa;
                border-radius: 12px;
                padding: 25px;
                text-align: center;
                box-shadow: 0 3px 8px rgba(0,0,0,0.1);
            ">
                <h3 style="font-size: 2rem; margin-bottom: 10px;">{{ totalLeaderboardEntries ?: '0' }}</h3>
                <p style="font-weight: 500; color: #555;">Leaderboard Entries</p>
            </div>
        </div>

        <hr style="margin-bottom: 40px;">

        <!-- Charts Section -->
        <div class="charts-grid" style="
            display: flex;
            flex-direction: column;
            gap: 50px;
        ">

            <!-- Monthly Users -->
            <div>
                <h3 class="mb-3" style="font-size: 1.75rem;">📈 Monthly User Registrations</h3>
                <canvas id="userChart" height="120"></canvas>
            </div>

            <!-- Quiz Categories -->
            <div>
                <h3 class="mb-3" style="font-size: 1.75rem;">🧠 Quizzes by Category</h3>
                <canvas id="quizChart" height="120"></canvas>
            </div>

            <!-- Top Scores -->
            <div>
                <h3 class="mb-3" style="font-size: 1.75rem;">🏆 Top 5 Leaderboard Scores</h3>
                <canvas id="leaderboardChart" height="120"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Ensure labels display even if empty
        const monthlyLabels = {{ monthlyUserStats|map(v => v.month)|json_encode|raw }} || ['No Data'];
        const monthlyData = {{ monthlyUserStats|map(v => v.total)|json_encode|raw }} || [0];

        const quizLabels = {{ quizStats|map(v => v.category)|json_encode|raw }} || ['No Categories'];
        const quizData = {{ quizStats|map(v => v.total)|json_encode|raw }} || [0];

        const leaderboardLabels = {{ topScores|map(v => v.username)|json_encode|raw }} || ['No Entries'];
        const leaderboardData = {{ topScores|map(v => v.score)|json_encode|raw }} || [0];

        // User Growth Chart
        new Chart(document.getElementById('userChart').getContext('2d'), {
            type: 'line',
            data: {
                labels: monthlyLabels,
                datasets: [{
                    label: 'New Users',
                    data: monthlyData,
                    borderColor: '#36A2EB',
                    backgroundColor: 'rgba(54, 162, 235, 0.2)',
                    tension: 0.3,
                    fill: true,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: true } },
                scales: { y: { beginAtZero: true } }
            }
        });

        // Quizzes by Category Chart
        new Chart(document.getElementById('quizChart').getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: quizLabels,
                datasets: [{
                    data: quizData,
                    backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40'],
                }]
            },
            options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
        });

        // Top Leaderboard Scores Chart
        new Chart(document.getElementById('leaderboardChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: leaderboardLabels,
                datasets: [{
                    label: 'Score',
                    data: leaderboardData,
                    backgroundColor: '#4CAF50'
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });
    </script>

{% endblock %}
